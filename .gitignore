/target
# generated per-build launcher inputs (real ones are injected by `panini build`)
/launcher/.zig-cache
/launcher/zig-out
/launcher/src/payload.tar.gz
/launcher/src/gen.zig
# gleam build output in the example
/examples/*/build
/examples/hello/hello
# built release/package artifacts (dist/ keeps only the deb/rpm templates)
/dist/*.tar.gz
/dist/*.deb
/dist/*.rpm
/dist/*.sha256
/dist/debian/*/usr
/dist/rpm/*/usr
/rpmbuild
/panini-*-*/
# nix
/result
